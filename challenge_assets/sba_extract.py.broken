NOTE TO INVESTIGATOR: This script was found alongside the archive
file auth_backup.sba. Several functions appear to have been
deliberately corrupted before the laptop was wiped. You will need
to repair the broken sections marked with [DAMAGED] before the
script can successfully extract the archive contents.

SBA Format Reference:
  - Magic: SBA\\x00 (4 bytes)
  - Version: uint16 LE (2 bytes)
  - FileCount: uint16 LE (2 bytes)
  - TOC Offset: uint64 LE (8 bytes)
  - TOC entries contain: name_len, name, offset, comp_size, decomp_size, comp_algo, encrypt_flag

Usage: python3 sba_extract.py auth_backup.sba [output_dir]
"""
import struct
import hashlib
import sys
import os


def parse_header(data: bytes) -> dict:
    """Parse the 16-byte SBA global header."""
    if len(data) < 16:
        raise ValueError("File too small for SBA header")

    magic = data[0:4]
    if magic != b"SBA\x00":
        raise ValueError(f"Invalid magic bytes: {magic}")

    version = struct.unpack("<H", data[4:6])[0]
    file_count = struct.unpack("<H", data[6:8])[0]
    toc_offset = struct.unpack("<Q", data[8:16])[0]

    return {
        "version": version,
        "file_count": file_count,
        "toc_offset": toc_offset,
    }


def parse_toc(data: bytes, toc_offset: int, file_count: int) -> list:
    """Parse the Table of Contents entries."""
    entries = []
    pos = toc_offset

    for _ in range(file_count):
        name_len = data[pos]
        pos += 1
        name = data[pos:pos + name_len].decode("ascii")
        pos += name_len
        file_offset = struct.unpack("<Q", data[pos:pos + 8])[0]
        pos += 8
        comp_size = struct.unpack("<Q", data[pos:pos + 8])[0]
        pos += 8
        decomp_size = struct.unpack("<Q", data[pos:pos + 8])[0]
        pos += 8
        comp_algo = data[pos]
        pos += 1
        encrypt_flag = data[pos]
        pos += 1

        entries.append({
            "name": name,
            "offset": file_offset,
            "comp_size": comp_size,
            "decomp_size": decomp_size,
            "comp_algo": comp_algo,
            "encrypt_flag": encrypt_flag,
        })

    return entries


