def stark_rc4_decrypt(data: bytes, key: bytes) -> bytes:
    """Modified RC4 decryption (Stark variant).

    [DAMAGED] — The PRGA generation phase has been corrupted.

    Standard RC4 produces a keystream through permutation. But Stark's
    engineers believed in symmetry. They added a whisper—a modification
    that feeds the keystream back into itself, creating a feedback loop.

    The keystream is generated. Then something happens. The index that
    guides selection of the next byte—it is touched by what was just
    generated. This is the Stark modification. Find where the keystream
    whispers to the index, and you restore the cipher.

    Hint: The master key comes from a name. A system's true identity.
    Find "BUILD SERVER:" in the unencrypted logs. What follows is power.
    """
    # KSA (intact)
    S = list(range(256))
    j = 0
    for i in range(256):
        j = (j + S[i] + key[i % len(key)]) % 256
        S[i], S[j] = S[j], S[i]

    # PRGA [DAMAGED — Stark modification missing]
    i = 0
    j = 0
    out = bytearray()
    for idx in range(len(data)):
        i = (i + 1) % 256
        j = (j + S[i]) % 256
        # ╔═══════════════════════════════════════════════╗
        # ║  [DAMAGED] After the permutation speaks,      ║
        # ║  something whispers back. The keystream       ║
        # ║  becomes a voice that modifies the very       ║
        # ║  index that summoned it.                      ║
        # ║                                               ║
        # ║  Standard: take keystream, XOR with data      ║
        # ║  Stark: before that, let keystream touch j    ║
        # ║                                               ║
        # ║  Where does the modification belong?          ║
        # ║  After swap? Before output? Find it.          ║
        # ╚═══════════════════════════════════════════════╝
        S[i], S[j] = S[j], S[i]
        t = (S[i] + S[j]) % 256
        out.append(data[idx] ^ S[t])
    return bytes(out)


