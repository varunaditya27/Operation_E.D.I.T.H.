def extract(sba_path: str, output_dir: str = "extracted"):
    """Extract all files from an SBA archive."""
    with open(sba_path, "rb") as f:
        data = f.read()

    header = parse_header(data)
    print(f"SBA v{header['version']}, {header['file_count']} files")
    print(f"TOC at offset: {header['toc_offset']}")

    entries = parse_toc(data, header["toc_offset"], header["file_count"])

    os.makedirs(output_dir, exist_ok=True)

    # First pass: find hostname from unencrypted files
    hostname = None
    for entry in entries:
        if entry["encrypt_flag"] == 0x00 and entry["name"] == "build_server.log":
            raw = data[entry["offset"]:entry["offset"] + entry["comp_size"]]
            if entry["comp_algo"] == 0x01:
                raw = rle_decompress(raw)
            content = raw.decode("utf-8", errors="replace")
            for line in content.split("\n"):
                if "BUILD SERVER:" in line:
                    hostname = line.split(":")[-1].strip()
                    print(f"[+] Found hostname: {hostname}")
                    break

    rc4_key = derive_rc4_key(hostname) if hostname else b"\x00" * 16

    # Second pass: extract all files
    for entry in entries:
        print(f"\nExtracting: {entry['name']}")
        print(f"  Offset: {entry['offset']}, Size: {entry['comp_size']}, "
              f"Decomp: {entry['decomp_size']}")
        print(f"  Compression: {entry['comp_algo']}, Encrypted: {entry['encrypt_flag']}")

        raw = data[entry["offset"]:entry["offset"] + entry["comp_size"]]

        # Decrypt if needed
        if entry["encrypt_flag"] == 0x01:
            raw = stark_rc4_decrypt(raw, rc4_key)

        # Decompress if needed
        if entry["comp_algo"] == 0x01:
            raw = rle_decompress(raw)

        # Write output
        out_path = os.path.join(output_dir, entry["name"])
        with open(out_path, "wb") as f:
            f.write(raw)
        print(f"  -> Written to {out_path} ({len(raw)} bytes)")


if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <archive.sba> [output_dir]")
        sys.exit(1)

    sba_file = sys.argv[1]
    out_dir = sys.argv[2] if len(sys.argv) > 2 else "extracted"
    extract(sba_file, out_dir)
