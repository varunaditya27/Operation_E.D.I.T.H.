def stark_rc4_decrypt(data: bytes, key: bytes) -> bytes:
    """Modified RC4 decryption (Stark variant).

    [DAMAGED] — The PRGA modification step has been removed.
    Standard RC4 won't work. The modification involves an XOR
    on the j index during the PRGA phase.

    Hint: The key is derived from MD5 of a hostname found in
    one of the unencrypted files in the archive.
    """
    # KSA (intact)
    S = list(range(256))
    j = 0
    for i in range(256):
        j = (j + S[i] + key[i % len(key)]) % 256
        S[i], S[j] = S[j], S[i]

    # PRGA [DAMAGED]
    i = 0
    j = 0
    out = bytearray()
    for idx in range(len(data)):
        i = (i + 1) % 256
        j = (j + S[i]) % 256
        # ╔══════════════════════════════════════════╗
        # ║  [DAMAGED SECTION — RECONSTRUCTION       ║
        # ║   REQUIRED]                              ║
        # ║                                          ║
        # ║  The standard RC4 PRGA has been modified ║
        # ║  with an additional XOR operation on the ║
        # ║  j index using the key stream.           ║
        # ║  Reconstruct the modification here.      ║
        # ╚══════════════════════════════════════════╝
        S[i], S[j] = S[j], S[i]
        t = (S[i] + S[j]) % 256
        out.append(data[idx] ^ S[t])
    return bytes(out)


